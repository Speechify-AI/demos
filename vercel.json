{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": "site/",
      "buildCommand": "pnpm run build",
      "outputDirectory": "public"
    },
    "next-voice-cloning-app": {
      "root": "demos/next-voice-cloning-app/",
      "framework": "nextjs"
    },
    "ai-sdk-speechify-speech": {
      "root": "demos/ai-sdk-speechify-speech/",
      "framework": "nextjs"
    },
    "multilingual-voiceover": {
      "root": "demos/multilingual-voiceover/",
      "framework": "nextjs"
    },
    "ivr-ssml": {
      "root": "demos/ivr-ssml/",
      "framework": "nextjs"
    },
    "webpage-audiobook": {
      "root": "demos/webpage-audiobook/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/ai-sdk-speechify-speech/:path*",
      "destination": {
        "service": "ai-sdk-speechify-speech"
      }
    },
    {
      "source": "/next-voice-cloning-app/:path*",
      "destination": {
        "service": "next-voice-cloning-app"
      }
    },
    {
      "source": "/multilingual-voiceover/:path*",
      "destination": { "service": "multilingual-voiceover" }
    },
    {
      "source": "/ivr-ssml/:path*",
      "destination": { "service": "ivr-ssml" }
    },
    {
      "source": "/webpage-audiobook/:path*",
      "destination": { "service": "webpage-audiobook" }
    },
    {
      "source": "/",
      "destination": {
        "service": "site",
        "path": "/index.html"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "site"
      }
    }
  ]
}