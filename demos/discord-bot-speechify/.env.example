SPEECHIFY_API_KEY=your_api_key_here
# Discord bot token: Discord Developer Portal > Application > Bot > Token
DISCORD_TOKEN=your_bot_token_here
# Application ID (Client ID) from the Discord Developer Portal
DISCORD_CLIENT_ID=your_client_id_here
# Optional: override the voice and model used to speak
# (defaults: simba-3.2 with the curated voice geffen_32 — the docs' canonical
# English pairing; retired simba-english/simba-multilingual are not supported)
# VOICE_ID=geffen_32
# MODEL_ID=simba-3.2
