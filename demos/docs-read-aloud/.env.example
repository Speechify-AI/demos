SPEECHIFY_API_KEY=your_api_key_here
# Optional: override the voice and model used for reading aloud
# (defaults: simba-3.2 with the curated voice geffen_32 — the docs' canonical
# English pairing; retired simba-english/simba-multilingual are not supported)
# VOICE_ID=geffen_32
# MODEL_ID=simba-3.2
# Optional: which port to serve on
# PORT=8787
