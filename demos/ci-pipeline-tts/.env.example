# Required: copy to .env and paste your key from https://platform.speechify.ai/api-keys
SPEECHIFY_API_KEY=your_api_key_here

# Optional: model and voice. simba-3.2 is the recommended English model.
SPEECHIFY_MODEL=simba-3.2
SPEECHIFY_VOICE_ID=geffen_32

# Optional: post the generated audio into a Discord channel via a webhook.
# Build a webhook in Discord (Server Settings -> Integrations -> Webhooks) and
# paste its URL here. Leave blank to just save the MP3 locally.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
